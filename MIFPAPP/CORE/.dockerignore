.env
.env.*

secrets/

.venv/
venv/
env/
# Docker matches these patterns per path component, so a bare "__pycache__/"
# only excludes the top level and nested packages would ship stale .pyc files
# compiled by the developer's interpreter.
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

data/
logs/
backups/
exports/
uploads/
instance/
# Runtime content must never enter the image build context. Packaged JSON
# configuration under config/ and mifp_app/ is intentionally NOT excluded.
assets/
conferences/
*.jsonl
*.log
config.local.*
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal
*.sqlite3-shm
*.sqlite3-wal
:memory:

node_modules/
npm-debug.log*

*.zip
*.tar
*.tar.gz
*.tgz
*.bak
dist/
build/
.cache/

.git/
.gitignore
.dockerignore
README.md
compose*.yaml
*.dockerbuild

.DS_Store
.idea/
.vscode/
