# ==============================================================================
# MIFP Webapp – Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# SECURITY: .env should NEVER be committed to version control.
#
# This is the only environment file used by native and Docker startup.
# ==============================================================================

# --- Flask ---
FLASK_ENV='development'

# --- Development debug (set to 1 for Werkzeug debugger, 0 for production-like) ---
# FLASK_DEBUG='1'

# --- Security (MUST change in production) ---
SECRET_KEY='CHANGE-ME-generate-with-openssl-rand-hex-32'
# Enable only temporarily when an authenticated database download is required.
ALLOW_DB_DUMP='0'
ALLOW_DB_RESTORE='0'
ADMIN_USERNAME='admin'
ADMIN_PASSWORD_HASH=''
ADMIN_SESSION_HOURS='8'
SESSION_COOKIE_SAMESITE='Lax'
# In production with HTTPS set to 1; set to 0 for local dev without HTTPS
SESSION_COOKIE_SECURE='0'
CSRF_ENABLED='1'
TRUST_PROXY='0'
# Comma-separated hostnames accepted by the Host-header check.
# REQUIRED in production (startup fails without it): mifp.eu,www.mifp.eu,127.0.0.1,localhost
TRUSTED_HOSTS='mifp.eu,www.mifp.eu,127.0.0.1,localhost'
ADMIN_WRITE_RATE_LIMIT='120'
ADMIN_WRITE_RATE_WINDOW_SECONDS='60'
BACKGROUND_JOB_WORKERS='auto'
BACKGROUND_JOB_MAX_PENDING='4'

# Production (gunicorn)
# Keep one process with SQLite; threads provide request concurrency.
GUNICORN_WORKERS='1'
GUNICORN_THREADS='4'
GUNICORN_BIND='127.0.0.1:8000'
# FLASK_ENV='production'
# FLASK_DEBUG='0'
# SESSION_COOKIE_SECURE='1'
# CSRF_ENABLED='1'

# --- Rate Limiting ---
LOGIN_MAX_ATTEMPTS='5'
LOGIN_LOCKOUT_SECONDS='60'
LOGIN_IP_MAX_ATTEMPTS='10'

# --- Persistent storage (relative to MIFPAPP/CORE/ or absolute) ---
DATABASE_PATH='../DATABASE/mifp.db'
ASSETS_DIR='../DATABASE/assets'
EXPORT_DIR='../DATABASE/exports'
LOG_DIR='../DATABASE/logs'
# Production startup/readiness reserve. Set 0 only for constrained local development.
STORAGE_MIN_FREE_MB='1024'
EXPORT_RETENTION_DAYS='1'
EXPORT_MAX_FILES='30'
EXPORT_MAX_MB='2048'

# --- Network / Flask config ---
FLASK_HOST='127.0.0.1'
FLASK_PORT='8000'
# Comma-separated list of internal domains (e.g., mifp.eu,www.mifp.eu,old.mifp.eu,events.mifp.eu)
INTERNAL_DOMAINS='mifp.eu,www.mifp.eu,old.mifp.eu,events.mifp.eu'
MIRROR_DEFAULT_HOST='www.mifp.eu'
# User-Agent string for HTTP requests
HTTP_USER_AGENT='MIFP-Webapp/1.0'

# --- Logging ---
LOG_LEVEL='INFO'
LOG_FORMAT='text'
LOG_OUTPUT='both'
LOG_COLORS='auto'
LOG_ACCESS_ENABLED='1'
LOG_AUDIT_ENABLED='1'
LOG_SECURITY_ENABLED='1'
LOG_SLOW_REQUEST_MS='5000'
LOG_INCLUDE_CLIENT_IP='0'
LOG_HASH_CLIENT_IP='1'
LOG_RETENTION_DAYS='30'
# Deprecated legacy setting: old page_views rows are not used for analytics.
PAGE_VIEWS_RETENTION_DAYS='365'
# Privacy-safe aggregate metrics; no visitor identifiers are stored.
PRIVACY_SAFE_METRICS_ENABLED='1'
PRIVACY_SAFE_METRICS_RETENTION_DAYS='730'

# --- Upload ---
MAX_CONTENT_LENGTH_MB='768'
UPLOAD_ALLOWED_EXTENSIONS='jpg,jpeg,png,gif,webp,pdf,doc,docx,mp4,mov,txt,csv,json'
IMPORT_MAX_ZIP_BYTES='805306368'
IMPORT_MAX_JSONL_BYTES='134217728'
IMPORT_MAX_MANIFEST_BYTES='4194304'
IMPORT_MAX_STATE_BYTES='134217728'
IMPORT_MAX_FILES='5000'
IMPORT_MAX_JSONL_LINES='20000'
IMPORT_MAX_UNPACKED_BYTES='1073741824'
ASSET_REMOTE_MAX_BYTES='67108864'
# Total HTTP attempts are shared by all fallback URLs for one asset.
ASSET_DOWNLOAD_TIMEOUT_SECONDS='10'
ASSET_DOWNLOAD_MAX_ATTEMPTS='3'
ASSET_RECOVERY_MAX_ASSETS_PER_RUN='30'
ASSET_RECOVERY_MAX_RUN_ATTEMPTS='3'
ASSET_RECOVERY_TIME_BUDGET_SECONDS='75'
ASSET_RECOVERY_BACKOFF_HOURS='6'
# Optional comma-separated allowlist for downloadable/registerable external assets.
# Empty means any public http/https host except localhost/private/link-local networks.
ASSET_ALLOWED_DOMAINS=''

# --- Conference website builder ---
# Persistent workspace for conference assets and generated-site inputs.
CONFERENCES_DIR='../DATABASE/conferences'

# --- Docker Compose host settings ---
MIFP_UID='1000'
MIFP_GID='1000'
MIFP_BIND='127.0.0.1'
MIFP_PORT='8000'
MIFP_DATA_DIR='../DATABASE'
MIFP_IMAGE_TAG='local'
# /tmp is reserved for small runtime scratch files. Upload/import staging uses
# TMPDIR=/app/data/tmp on the persistent data volume, avoiding large tmpfs RAM spikes.
MIFP_TMP_SIZE='256m'
MIFP_MEMORY_LIMIT='1g'
MIFP_CPU_LIMIT='2.0'

# --- Scraper defaults used by ./mifp scrape ---
MIFP_SCRAPER_THREADS='16'
MIFP_SCRAPER_LOCAL_ROOT='/run/media/matteo/ARCHDISK/srv/http/mifp.eu'

# --- Email ---
MAIL_PROVIDER='disabled'
MAIL_FROM='no-reply@mifp.eu'
MAIL_TO='info@mifp.eu'
SMTP_HOST=''
SMTP_PORT='587'
SMTP_USERNAME=''
SMTP_PASSWORD=''
SMTP_USE_TLS='1'

# --- Join requests ---
JOIN_MAX_PER_IP_HOUR='5'
JOIN_STORE_RAW_IP='0'

# --- Startup ---
AUTO_MIGRATE_ON_STARTUP='1'
SITE_SETTINGS_CACHE_SECONDS='30'

# --- Testing ---
TESTING='0'
