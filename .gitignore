# Secrets and machine-local configuration
.env
.env.*
**/.env
**/.env.*
secrets/
**/secrets/
credentials.json
credentials.*.json
*.secret
*.token
*.key
*.pem
*.p12
*.pfx
.htpasswd

# Public deployment templates must remain versioned despite the rules above.
!MIFPAPP/CORE/.env.example
!deploy/.env.production.example

# Generated scraper/import data. SCRAPERS/ itself is source code.
SCRAPERS/OUTPUTS/
SCRAPER/
scrapers_/
IMPORT_DATA/
NEW_IMPORT_DATA/

# Persistent application data (never source code)
# MIFPAPP/DATABASE/
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal
rate_limit.sqlite3
:memory:

# Runtime output
data/
logs/
backups/
exports/
uploads/
instance/
.mifp/
*.log

# Exported archives and backups
*.zip
*.tar
*.tar.gz
*.tgz
*.bak

# Python environments and generated caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
/.mifp-test-runtime.*/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.coverage
coverage.xml
htmlcov/
*.egg-info/

# Generated build output
build/
dist/
.cache/
node_modules/
npm-debug.log*
*.dockerbuild

# Patch, merge and editor leftovers
*.orig
*.rej
*.swp
*.swo
*~

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local agent/tool state
.codex/
.agents/
.superpowers/*

# MIFP runtime state: code under MIFPAPP/DATABASE/tools stays versioned,
# concrete application data never does.
MIFPAPP/DATABASE/assets/
MIFPAPP/DATABASE/backups/
MIFPAPP/DATABASE/config/
MIFPAPP/DATABASE/conferences/
MIFPAPP/DATABASE/exports/
MIFPAPP/DATABASE/logs/
MIFPAPP/DATABASE/tmp/
MIFPAPP/DATABASE/uploads/
