# Base template for the MIFP application domains. deploy.sh/bootstrap-vps.sh
# append a direct static events site only when EVENTS_PUBLISH_BACKEND=local-vps.
# Remote/disabled mode leaves that host entirely outside VPS Caddy and ACME.

# One canonical public host: avoid serving duplicate www/apex URL surfaces.
__MIFP_WWW_DOMAIN__ {
    __MIFP_TLS__
    redir https://__MIFP_DOMAIN__{uri} permanent
}

__MIFP_DOMAIN__ {
    __MIFP_TLS__
    encode zstd gzip
    header -Server

    # /ready contains operational details and is only for Docker/deploy checks.
    @ready path /ready
    respond @ready 404

    reverse_proxy 127.0.0.1:8000
}
