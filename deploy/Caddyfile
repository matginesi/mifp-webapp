# Installed by bootstrap-vps.sh after replacing __MIFP_DOMAIN__.
# Docker publishes the application only on the VPS loopback interface.
__MIFP_DOMAIN__, www.__MIFP_DOMAIN__ {
    encode zstd gzip
    header -Server

    # /ready contains operational details and is only for Docker/deploy checks.
    @ready path /ready
    respond @ready 404

    reverse_proxy 127.0.0.1:8000
}
