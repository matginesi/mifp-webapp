# ==============================================================================
# MIFP Webapp - Production Environment Template (VPS host)
# ==============================================================================
# Installed as the compatible runtime env. Secrets live in
# /etc/mifp/secrets.env and are loaded directly by Compose/systemd.
# SECURITY: /opt/mifp/.env must NEVER be committed; keep it chmod 600.
# The container env_file points at /opt/mifp/.env; deploy.sh also uses it as
# the compose interpolation file.
# ==============================================================================

# Repository only (no tag). deploy.sh accepts a short immutable tag such as
# sha-<commit> and expands it against this repository.
MIFP_IMAGE_REPOSITORY='ghcr.io/matginesi/mifp-webapp'


# --- Security (REQUIRED in production) ---
# mifpctl configuration initializes/rotates secrets; do not edit plaintext passwords here.
SECRET_KEY=''
ADMIN_USERNAME='admin'
ADMIN_PASSWORD_HASH=''
# Comma-separated hostnames accepted by the Host-header check.
TRUSTED_HOSTS='127.0.0.1,localhost'

# --- Domain used by the host Caddyfile ---
# `mifpctl config-set DOMAIN mifp.eu` derives www.mifp.eu. Event publisher
# configuration is managed separately with `mifpctl configure --section publisher`.
# Canonical values live in /etc/mifp/config.env.
MIFP_DOMAIN=''

# --- Event-site publisher (Phase 1: local-vps) ---
EVENTS_PUBLISH_BACKEND='local-vps'
EVENTS_PUBLIC_BASE_URL='https://events.mifp.eu'
EVENTS_LOCAL_ROOT='/srv/mifp-events'
EVENTS_REMOTE_PROTOCOL='ftps'
EVENTS_REMOTE_HOST=''
EVENTS_REMOTE_PORT='21'
EVENTS_REMOTE_USER=''
EVENTS_REMOTE_PASSWORD=''
EVENTS_REMOTE_ROOT=''
EVENTS_REMOTE_TIMEOUT='30'

# --- Resource limits / tuning (defaults used by deploy/compose.production.yaml) ---
MIFP_MEMORY_LIMIT='1536m'
MIFP_CPU_LIMIT='2.0'
MIFP_TMP_SIZE='256m'
GUNICORN_WORKERS='1'
GUNICORN_THREADS='4'
LOG_FORMAT='json'
LOG_FILE_FORMAT='json'
LOG_CONSOLE_FORMAT='text'
STORAGE_MIN_FREE_MB='1024'
# Upload/import: accept packages up to exactly 1 GiB; leave multipart overhead
# outside the advertised per-file limit.
MAX_UPLOAD_FILE_BYTES='1073741824'
MAX_CONTENT_LENGTH_MB='1032'
IMPORT_MAX_ZIP_BYTES='1073741824'
IMPORT_MAX_UNPACKED_BYTES='1073741824'
EVENT_IMPORT_MAX_FILE_BYTES='134217728'
# Embed DB-tracked remote assets from MIFP-owned domains in dashboard ZIP exports.
# The parent domain matches subdomains (www/old/events.mifp.eu).
PORTABLE_EXPORT_PRESERVE_DOMAINS='mifp.eu'

# --- Mail (optional) ---
# Configure/rotate SMTP safely with: sudo mifpctl configure --section mail
# SMTP_PASSWORD is a placeholder here only. The real secret lives in the
# root-only /etc/mifp/secrets.env, is mounted into the web container through
# /run/secrets (never as a container environment variable), and is also used
# by the independent host alert monitor plus the local-vps PHP regform relay.
MAIL_PROVIDER='disabled'
MAIL_FROM='no-reply@mifp.eu'
MAIL_TO='info@mifp.eu'
SMTP_HOST=''
SMTP_PORT='587'
SMTP_USERNAME=''
SMTP_PASSWORD=''
SMTP_SECURITY='starttls'

# --- Host deployment / backup safety ---
MIFP_DEPLOY_MIN_FREE_MB='2048'
MIFP_BACKUP_KEEP='14'
MIFP_BACKUP_QUIESCE='1'

# Optional encrypted off-site backup with restic. Leave empty to disable.
MIFP_RESTIC_REPOSITORY=''
MIFP_RESTIC_PASSWORD_FILE=''
BACKGROUND_JOB_WORKERS='1'
