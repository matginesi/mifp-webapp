# ==============================================================================
# MIFP Webapp - Production Environment Template (VPS host)
# ==============================================================================
# Copy this file to /opt/mifp/.env on the VPS and fill in real values.
# SECURITY: /opt/mifp/.env must NEVER be committed; keep it chmod 600.
# The container env_file points at /opt/mifp/.env; deploy.sh also uses it as
# the compose interpolation file.
# ==============================================================================

# --- Image released by GitHub Actions (CI/CD) ---
# MIFP_IMAGE=ghcr.io/matginesi/mifp-webapp:sha-<commit>

# --- Security (REQUIRED in production) ---
# Generate with: openssl rand -hex 32
SECRET_KEY='CHANGE-ME-generate-with-openssl-rand-hex-32'
# Generate locally with: ./mifp hash  (never with a plaintext password here)
ADMIN_USERNAME='admin'
ADMIN_PASSWORD_HASH=''
# Comma-separated hostnames accepted by the Host-header check.
TRUSTED_HOSTS='mifp.eu,www.mifp.eu,127.0.0.1,localhost'
INTERNAL_DOMAINS='mifp.eu,www.mifp.eu,old.mifp.eu,events.mifp.eu'

# --- Domain used by the host Caddyfile ---
MIFP_DOMAIN='mifp.eu'

# --- Resource limits / tuning (defaults used by deploy/compose.production.yaml) ---
MIFP_MEMORY_LIMIT='1g'
MIFP_CPU_LIMIT='2.0'
MIFP_TMP_SIZE='256m'
GUNICORN_WORKERS='1'
GUNICORN_THREADS='4'
LOG_FORMAT='json'
STORAGE_MIN_FREE_MB='1024'

# --- Mail (optional) ---
MAIL_PROVIDER='disabled'
MAIL_FROM='no-reply@mifp.eu'
MAIL_TO='info@mifp.eu'
SMTP_HOST=''
SMTP_PORT='587'
SMTP_USERNAME=''
SMTP_PASSWORD=''
SMTP_USE_TLS='1'