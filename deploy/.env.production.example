# ==============================================================================
# MIFP Webapp - Production Environment Template (VPS host)
# ==============================================================================
# Installed as the compatible runtime env. Secrets live in
# /etc/mifp/secrets.env and are loaded directly by Compose/systemd.
# SECURITY: /opt/mifp/.env must NEVER be committed; keep it chmod 600.
# The container env_file points at /opt/mifp/.env; deploy.sh also uses it as
# the compose interpolation file.
# ==============================================================================

# Repository only (no tag). deploy.sh accepts a short immutable tag such as
# sha-<commit> and expands it against this repository.
MIFP_IMAGE_REPOSITORY='ghcr.io/matginesi/mifp-webapp'


# --- Security (REQUIRED in production) ---
# bootstrap-vps.sh generates this automatically. Do not edit unless rotating it.
SECRET_KEY=''
ADMIN_USERNAME='admin'
ADMIN_PASSWORD_HASH=''
# Comma-separated hostnames accepted by the Host-header check.
TRUSTED_HOSTS='127.0.0.1,localhost'

# --- Domain used by the host Caddyfile ---
MIFP_DOMAIN=''

# --- Resource limits / tuning (defaults used by deploy/compose.production.yaml) ---
MIFP_MEMORY_LIMIT='1536m'
MIFP_CPU_LIMIT='2.0'
MIFP_TMP_SIZE='256m'
GUNICORN_WORKERS='1'
GUNICORN_THREADS='4'
LOG_FORMAT='json'
STORAGE_MIN_FREE_MB='1024'

# --- Mail (optional) ---
MAIL_PROVIDER='disabled'
MAIL_FROM='no-reply@mifp.eu'
MAIL_TO='info@mifp.eu'
SMTP_HOST=''
SMTP_PORT='587'
SMTP_USERNAME=''
SMTP_PASSWORD=''
SMTP_USE_TLS='1'
SMTP_SECURITY='starttls'

# --- Host deployment / backup safety ---
MIFP_DEPLOY_MIN_FREE_MB='2048'
MIFP_BACKUP_KEEP='14'
MIFP_BACKUP_QUIESCE='1'

# Optional encrypted off-site backup with restic. Leave empty to disable.
MIFP_RESTIC_REPOSITORY=''
MIFP_RESTIC_PASSWORD_FILE=''
BACKGROUND_JOB_WORKERS='1'
