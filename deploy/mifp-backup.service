[Unit]
Description=MIFP SQLite, file and conference-site backup
After=local-fs.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/mifp/secrets.env
UnsetEnvironment=SECRET_KEY ADMIN_PASSWORD_HASH SMTP_PASSWORD
UMask=0077
ExecStart=/opt/mifp/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
